# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Claude API ---
# Ключ из Claude Console (workspace этого проекта с лимитом расходов).
# Передаётся в SDK явно: Anthropic(api_key=...). Стандартную переменную ключа Anthropic
# не заводите ни здесь, ни в системе: она переключит Claude Code с подписки на оплату через API.
VENMART_ANTHROPIC_KEY=

# --- Postgres (docker-compose) ---
POSTGRES_DB=tanbala
POSTGRES_USER=tanbala
# Длинный случайный пароль, например: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Тот же пароль, что в POSTGRES_PASSWORD.
DATABASE_URL=postgresql://tanbala:CHANGE_ME@127.0.0.1:5432/tanbala
# Для тестов можно указать отдельную базу, иначе берётся DATABASE_URL (тесты работают во временной схеме).
# TEST_DATABASE_URL=

# --- Reacher (проверка почт) ---
REACHER_URL=http://127.0.0.1:8080
REACHER_PORT=8080
# Секрет для заголовка x-reacher-secret, тоже длинная случайная строка.
REACHER_SECRET=
# Имя для SMTP HELO, лучше совпадающее с обратной DNS-записью сервера.
REACHER_HELLO_NAME=localhost
# Адрес в MAIL FROM при проверке. Письма с него не отправляются.
REACHER_FROM_EMAIL=hello@localhost
REACHER_SMTP_TIMEOUT=45
# Пауза между проверками: не больше стольких проверок в минуту.
REACHER_MAX_PER_MINUTE=10

# --- parser-2gis (отдельное окружение .venv-2gis) ---
PARSER_2GIS_BIN=.venv-2gis/Scripts/parser-2gis.exe

# --- Подпись и контакты (раздел 14 документа о Tanbala) ---
AGENT_NAME=
AGENT_WHATSAPP=
# Почта, с которой пишет агент.
AGENT_EMAIL=tanbala@venmart.kz

# --- Отправка ---
# Тестовый режим: все письма уходят только на этот адрес. Другой адрес код не примет:
# разрешённый получатель зашит в tanbala_leads/steps/send.py и в базе (test_sends).
DRY_RUN_TO=bogdansm2000@gmail.com

# --- Почта: SMTP для отправки, IMAP для ответов. Пароли вписывает владелец. ---
SMTP_HOST=venmart.kz
SMTP_PORT=465
SMTP_USER=tanbala@venmart.kz
SMTP_PASSWORD=
IMAP_HOST=venmart.kz
IMAP_PORT=993
IMAP_USER=tanbala@venmart.kz
IMAP_PASSWORD=

# --- Расходы ---
# Новый поиск не запустится, если за сегодня (по Алматы) на Claude API ушло больше этой суммы, в долларах.
DAILY_API_BUDGET_USD=1.00

# --- Внутренний API для WhatsApp-бота (проект C), только 127.0.0.1 ---
# Токен для заголовка X-Internal-Token, не короче 32 символов. Пустой: API выключен (на всё 401).
# Создать: python -c "import secrets; print(secrets.token_urlsafe(32))". Тот же токен нужен проекту C.
INTERNAL_API_TOKEN=
# Сколько новых компаний бот может проверить за сутки (по Алматы): 2ГИС, сайт и один вызов Haiku на каждую.
RESEARCH_PER_DAY=20

# --- Браузеры (VPS 4 ГБ) ---
# Сколько браузеров одновременно на весь сервер: поиск из интерфейса и проверки из WhatsApp делят их.
# Chrome для 2ГИС ≈ 1 ГБ, Chromium для сайтов ≈ 0.75 ГБ. Проверка из WhatsApp идёт вне очереди между шагами поиска.
MAX_2GIS_BROWSERS=1
MAX_SITE_BROWSERS=1

# --- Интерфейс за Caddy (сервер) ---
# Имя, по которому интерфейс открывают через Caddy (HTTPS и пароль в Caddy), например leads.tanbala.kz.
# Без схемы, порта и пути. Пусто: интерфейс только по 127.0.0.1 и localhost (ПК). Внутренний API по этому имени
# недоступен в любом случае: /internal только по 127.0.0.1 и localhost.
PUBLIC_UI_HOST=

# --- Логи ---
# Каждый реальный вызов API: модель, входные и выходные токены.
LLM_LOG_PATH=logs/llm_calls.jsonl
