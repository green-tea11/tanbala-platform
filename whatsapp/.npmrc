# Точные версии: обновления зависимостей только осознанно, отдельным коммитом
save-exact=true
# Install-скрипты пакетов не запускаются (защита цепочки поставок).
# Если пакету скрипт нужен, запустить точечно: npm rebuild <пакет>
ignore-scripts=true
# Не ставить пакеты, если версия Node не подходит
engine-strict=true
