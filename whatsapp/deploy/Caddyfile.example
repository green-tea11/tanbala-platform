# Шаблон Caddyfile для панели Tanbala. Копируется в /etc/caddy/Caddyfile (docs/DEPLOY.md, шаг 6). Секретов здесь нет.
#
# 1. Замените panel.example.kz на свой домен. Он же должен стоять в PANEL_ALLOWED_HOSTS в .env, один в один.
# 2. DNS A-запись домена ведёт на IP сервера, порты 80 и 443 открыты. Тогда Caddy сам получит и будет
#    продлевать сертификат, включит HTTPS и перенаправит http на https.

# Необязательно: почта для уведомлений о сертификате. Блок глобальных настроек должен идти первым в файле.
# {
# 	email admin@example.kz
# }

panel.example.kz {
	# Адрес именно 127.0.0.1 (IPv4), а не localhost: панель слушает только 127.0.0.1,
	# а localhost может разрешиться в ::1, и соединение не дойдёт.
	# Заголовок Host Caddy передаёт как есть, X-Forwarded-For и X-Forwarded-Proto ставит сам.
	# Панель верит им только от 127.0.0.1 и пускает домен только по HTTPS (иначе 403).
	reverse_proxy 127.0.0.1:3100
}
