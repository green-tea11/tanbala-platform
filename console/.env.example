# Единая панель Tanbala (console): настройки. Скопировать в .env и заполнить.
# На сервере .env принадлежит root, группа tanbala-console, права 640. В git .env не кладётся.

# Где слушает консоль: только 127.0.0.1 (снаружи — Caddy с паролем и HTTPS).
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=3200

# Домены консоли за Caddy, как их шлёт браузер в Host (только по HTTPS). 127.0.0.1 и localhost разрешены всегда.
CONSOLE_ALLOWED_HOSTS=panel.tanbala.kz

# Почта (leads): адрес только http://127.0.0.1:<порт>, свой токен (32–512 видимых символов ASCII).
# Тот же токен — в .env почты (LEADS_CONSOLE_TOKEN). Сгенерировать: openssl rand -hex 32
LEADS_API_URL=http://127.0.0.1:8000
LEADS_CONSOLE_TOKEN=

# Бот (whatsapp): отдельный сервер API на 127.0.0.1:3101, свой токен — ДРУГОЙ, чем у почты;
# тот же токен — в .env бота (WA_CONSOLE_TOKEN).
WA_API_URL=http://127.0.0.1:3101
WA_CONSOLE_TOKEN=

# База консоли (пользователи, сессии, журнал действий, отметки «видел»): только внутри data/.
CONSOLE_DATABASE_PATH=data/console.db

# trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info

# Прокси Node для fetch (NODE_USE_ENV_PROXY, --use-env-proxy) включать нельзя: консоль не запустится.
