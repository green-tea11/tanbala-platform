# Настройки проекта. Это шаблон: скопируйте его в .env и впишите значения.
# Файл .env в git не попадает. Пустые значения заполняет владелец.

# Ключ Claude API этого проекта (отдельный ключ в той же организации Console).
# Передаётся в SDK явно. Стандартную переменную ключа SDK проект не читает.
VENMART_ANTHROPIC_KEY=

# Номер менеджера для уведомлений: только цифры с кодом страны, например 7XXXXXXXXXX.
MANAGER_WHATSAPP=

# Пароль веб-панели. С паролем admin панель запускается только на 127.0.0.1.
# На VPS только HTTPS и сложный пароль, не короче 16 символов.
ADMIN_PASSWORD=admin

# Ключ OpenRouter для расшифровки голосовых. Пока пустой: модуль голоса ещё заготовка.
OPENROUTER_API_KEY=

# Подключение к WhatsApp. Пока false, бот не показывает QR и не подключается.
# Включает владелец, когда разрешит.
WA_ENABLED=false

# Папка сессии WhatsApp (Baileys). Даёт полный доступ к номеру: не копировать и не коммитить.
WHATSAPP_SESSION_DIR=./data/whatsapp-session

# База данных SQLite: диалоги, статусы чатов, карточки клиентов.
# Персональные данные клиентов: рабочая база только на VPS в Казахстане.
DATABASE_PATH=./data/tanbala.db

# Лог расхода API: время, модель, входные и выходные токены, по одной строке JSON на вызов.
TOKEN_LOG_PATH=./data/token-usage.jsonl

# Предохранитель расходов: вызовов API в сутки на весь бот и на один чат.
# Если лимит превышен, бот замолкает в этом чате и уведомляет менеджера.
API_DAILY_LIMIT=500
API_DAILY_LIMIT_PER_CHAT=40

# Веб-панель. Пока проект на ПК, только 127.0.0.1.
PANEL_HOST=127.0.0.1
PANEL_PORT=3100
