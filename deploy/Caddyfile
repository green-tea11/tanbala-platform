# Caddy для сервера Tanbala (PS.KZ, 91.201.215.210). Копия: /etc/caddy/Caddyfile, ставит её install.sh (шаг caddy),
# когда есть оба файла паролей wa и leads; до этого там Caddyfile.closed. С этапа Б (31.10.2026, «ок» владельца) wa. и
# leads. ведут на единую панель panel.tanbala.kz; старые панели работают на своих портах, их не удаляли.
# HTTPS и сертификаты Caddy получает и продлевает сам (нужны DNS и открытые порты 80 и 443).
# Пароли basic auth здесь не хранятся: строки «имя хэш» лежат в /etc/caddy/auth/wa.caddy, leads.caddy и panel.caddy
# (root:caddy, права 640), как их создать — deploy/env.md. Глобальные опции и (common) — в caddy/common.caddy.
# Не добавлять сайты «на всё» (:443, http://, *): запрос с чужим именем дошёл бы до приложений.
import /opt/tanbala/deploy/caddy/common.caddy
# Сайт tanbala.kz и www: открыт всем, в обоих режимах.
import /opt/tanbala/deploy/caddy/site.caddy
# Единая панель panel.tanbala.kz: режим свой, от паролей wa. и leads. не зависит. install.sh (шаг caddy) кладёт сюда
# caddy/panel.caddy, если есть /etc/caddy/auth/panel.caddy, иначе caddy/panel.closed.caddy (503).
import /etc/caddy/panel-site.caddy

# Бывшая панель бота: перенаправление на panel (этап Б). 302, а не 301: браузер не запоминает его навсегда, откат —
# прежний блок с basic_auth и reverse_proxy 127.0.0.1:3100 (git). Ссылка на чат /chats/{id} ведёт на тот же чат:
# номера чатов у панели бота и у консоли одни. Пароль Caddy больше не нужен: у panel свой пароль и вход.
wa.tanbala.kz {
	import common
	route {
		@chat path_regexp chat ^/chats/(\d{1,12})$
		redir @chat https://panel.tanbala.kz/chats/{re.chat.1} 302
		redir https://panel.tanbala.kz/ 302
	}
}

# Бывший интерфейс почты: перенаправление на panel (этап Б). Ссылки из уведомлений менеджеру
# (EMAIL_UI_URL + /companies/{id}) открывают ту же компанию. Путь с internal снаружи — по-прежнему 404; route нужен:
# в стандартном порядке Caddy redir идёт раньше respond, и /internal ушёл бы в перенаправление.
leads.tanbala.kz {
	import common
	route {
		@internal path_regexp internal (?i)(^|/)internal([/;]|$)
		respond @internal 404
		@card path_regexp card ^/companies/(\d{1,19})$
		redir @card https://panel.tanbala.kz/companies/{re.card.1} 302
		redir https://panel.tanbala.kz/ 302
	}
}
