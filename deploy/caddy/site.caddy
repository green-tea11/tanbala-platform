# Сайт Tanbala: открыт всем, без пароля. Статика (сборка Astro из A-site) из /srv/tanbala-site/current,
# выкладывает deploy/scripts/site.sh. Импортируют оба Caddyfile после common.caddy: сайт работает и до паролей панелей.
tanbala.kz {
	import common
	root * /srv/tanbala-site/current
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	# Файлы в /_astro/ с хэшем в имени не меняются: браузер держит их год. Страницу проверяет каждый раз.
	# Только существующие: 404 на старый файл (открытая вкладка после выкладки) не должен застрять на год.
	@hashed {
		path /_astro/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	file_server
}

www.tanbala.kz {
	import common
	redir https://tanbala.kz{uri} permanent
}
