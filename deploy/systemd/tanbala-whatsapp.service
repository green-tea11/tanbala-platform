# Служба: WhatsApp-бот и его панель (проект whatsapp), панель только 127.0.0.1:3100. Копия: /etc/systemd/system/.
# Основа: whatsapp/deploy/tanbala.service, пути и пользователь под общий сервер. Секретов здесь нет: бот сам читает
# /opt/tanbala/whatsapp/.env. Комментарии только на отдельных строках.

[Unit]
Description=Tanbala WhatsApp: бот и панель (127.0.0.1:3100)
# Без внутреннего API бот работает, только без данных о компании: зависимости нет, только порядок запуска.
After=network-online.target tanbala-leads.service tanbala-firewall.service
Wants=network-online.target
# Без правил nftables служба не стартует: они ограничивают бота внутренним API почты.
Requires=tanbala-firewall.service
# Не больше 4 запусков за 10 минут, дальше failed (start-limit-hit): читать журнал, затем
# systemctl reset-failed tanbala-whatsapp && systemctl start tanbala-whatsapp.
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=simple
User=tanbala-wa
Group=tanbala-wa
WorkingDirectory=/opt/tanbala/whatsapp
Environment=HOME=/opt/tanbala/whatsapp

# Права на личные данные: сессия WhatsApp 700 (её файлы 600), база и её -wal/-shm 600, даже если их создали вручную
# без umask 077 (привязка по QR из консоли). От имени бота, не root; отсутствие файлов не ошибка.
ExecStartPre=/bin/sh -c 'find data/whatsapp-session -type d -exec chmod 700 {} + ; find data/whatsapp-session -type f -exec chmod 600 {} + ; find data -maxdepth 1 -name "tanbala.db*" -type f -exec chmod 600 {} + ; exit 0'
# Запуск только при привязанной сессии WhatsApp (в creds.json есть ключ "me"). Без неё бот сам начал бы привязку
# по QR, которую под systemd никто не отсканирует, а каждая попытка тратит одну из двух за 24 часа.
# Привязка — только вручную и только по команде владельца.
ExecStartPre=/usr/bin/grep -qs '"me":' /opt/tanbala/whatsapp/data/whatsapp-session/creds.json
ExecStart=/usr/local/bin/node /opt/tanbala/whatsapp/dist/cli.js

# 0: штатная остановка (SIGTERM), без перезапуска. 1: любой сбой, перезапуск через минуту с пределом выше.
Restart=on-failure
RestartSec=60
# При остановке бот доводит ответы в работе (один вызов модели до 60 секунд).
TimeoutStopSec=120
UMask=0077

# Память: бот ≈ 0.15–0.3 ГБ. При общей нехватке памяти бот уходит последним (OOMScoreAdjust), а первые 256 МБ
# ядро у него не отнимает и не уводит в swap, пока браузеры почты ищут компании (MemoryLow).
MemoryLow=256M
MemoryHigh=600M
MemoryMax=800M
OOMScoreAdjust=-300

# Песочница. Писать можно только в папку проекта: база и сессия в data/, счётчик привязок в корне проекта.
# MemoryDenyWriteExecute не ставить: JIT V8 в Node не запустится.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tanbala/whatsapp
# Чужое (почта с её .env, копии баз, пароли и API Caddy) служба не видит вовсе.
InaccessiblePaths=-/opt/tanbala/leads -/var/backups/tanbala -/etc/caddy/auth -/etc/tanbala -/var/lib/caddy
PrivateDevices=true
ProtectProc=invisible
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
