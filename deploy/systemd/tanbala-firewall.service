# Правила nftables (deploy/nftables/tanbala-guard.nft): куда пользователям служб можно ходить внутри сервера.
# Службы почты, бота и консоли без этих правил не стартуют (Requires). Проверить: nft list table inet tanbala_guard
# Загружать после установки Caddy и создания пользователей tanbala-leads, tanbala-wa, tanbala-console и
# tanbala-build: nft ищет их по имени.

[Unit]
Description=Tanbala: правила nftables для служб (локальные порты, браузеры почты)
Before=tanbala-leads.service tanbala-whatsapp.service tanbala-console.service caddy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /opt/tanbala/deploy/nftables/tanbala-guard.nft
# Новые правила без остановки: restart остановил бы и службы с Requires=tanbala-firewall (файл пересоздаёт таблицу).
ExecReload=/usr/sbin/nft -f /opt/tanbala/deploy/nftables/tanbala-guard.nft
ExecStop=/usr/sbin/nft delete table inet tanbala_guard

[Install]
WantedBy=multi-user.target
